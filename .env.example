# Required environment variables for Auto-Clipper

# OpenRouter API key (required for LLM scoring)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) Choose your scoring model on OpenRouter:
# - google/gemini-2.0-flash-001 (DEFAULT — ultra-fast, high quality, ~$0.0003 per run: $1 = 3000+ runs!)
# - openai/gpt-4o-mini          (super reliable, ~$0.0005 per run: $1 = 2000+ runs)
# - deepseek/deepseek-chat      (DeepSeek V3, ~$0.0004 per run)
# - meta-llama/llama-3.3-70b-instruct:free (100% FREE on OpenRouter)
# - anthropic/claude-sonnet-4-5 (premium, ~$0.01 per run)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

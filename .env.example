# Required environment variables for Auto-Clipper

# OpenRouter API key (required for LLM scoring)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) Choose your scoring model on OpenRouter:
# - openai/gpt-4o-mini          (DEFAULT — ChatGPT 4o-mini, fast, accurate, ~$0.0005/run)
# - openai/gpt-4o               (Full GPT-4o)
# - meta-llama/llama-3.3-70b-instruct:free (100% FREE on OpenRouter)
# - deepseek/deepseek-chat      (DeepSeek V3, ~$0.0004/run)
# - anthropic/claude-sonnet-4-5 (Claude 3.5 Sonnet)
OPENROUTER_MODEL=openai/gpt-4o-mini
